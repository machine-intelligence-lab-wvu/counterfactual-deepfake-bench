__pycache__/
*.pyc
.venv/
logs/*
!logs/.gitkeep
# generated media and weights live on Hugging Face, never in git
*.mp4
*.safetensors
*.zip
# evaluation: score/preprocess parquet stays on disk (a CSV export per snapshot is committed)
results/scores/
results/preprocess/**/*.parquet
eval/**/__pycache__/
.pytest_cache/
